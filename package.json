{
  "name": "settleiq",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "postinstall": "pnpm --filter @settleiq/db generate",
    "db:generate": "dotenv -e .env -- pnpm --filter @settleiq/db generate",
    "db:push": "dotenv -e .env -- pnpm --filter @settleiq/db push",
    "db:studio": "dotenv -e .env -- pnpm --filter @settleiq/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
