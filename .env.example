# ---------------------------------------------------------------------------
# SettleIQ — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------------------

# Database (PostgreSQL — e.g. Neon, Supabase, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/settleiq?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Razorpay (test mode keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# OpenAI (Phase 3 — agent reasoning)
OPENAI_API_KEY="sk-..."

# Optional: Upstash Redis (background jobs — Phase 1+)
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Optional: Inngest (background jobs — Phase 1+)
# INNGEST_EVENT_KEY="..."
# INNGEST_SIGNING_KEY="..."

# Optional: Sentry (error tracking)
# SENTRY_DSN="https://...@sentry.io/..."

# Encryption key for storing Razorpay secrets (generate: openssl rand -hex 32)
ENCRYPTION_KEY=""
